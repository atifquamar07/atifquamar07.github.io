{% if site.enable_visit_tracker and site.visit_tracker_url %}
  <script>
    (function () {
      var card = document.currentScript.previousElementSibling;
      var pins = card.querySelector(".visitor-map__pins");
      var caption = card.querySelector(".visitor-map__caption");
      var endpoint = {{ site.visit_tracker_url | jsonify }}.replace(/\/+$/, "");
      var names = window.Intl && Intl.DisplayNames ? new Intl.DisplayNames(["en"], { type: "region" }) : null;
      function countryName(code) {
        try {
          return (names && names.of(code)) || code;
        } catch (e) {
          return code;
        }
      }

      fetch(endpoint + "/map")
        .then(function (res) {
          return res.ok ? res.json() : null;
        })
        .then(function (data) {
          if (!data || !data.points || !data.points.length) return;
          var max = data.points[0].views;
          /* Smallest last, so busy cities never hide quieter ones. */
          data.points
            .slice()
            .reverse()
            .forEach(function (p) {
              if (p.lat < -60 || p.lat > 84) return;
              var pin = document.createElementNS("http://www.w3.org/2000/svg", "circle");
              pin.setAttribute("cx", (p.lon + 180).toFixed(1));
              pin.setAttribute("cy", (84 - p.lat).toFixed(1));
              pin.setAttribute("r", (2.6 + 3.4 * Math.sqrt(p.views / max)).toFixed(1));
              var label = document.createElementNS("http://www.w3.org/2000/svg", "title");
              label.textContent = [p.city, p.country ? countryName(p.country) : null].filter(Boolean).join(", ");
              pin.appendChild(label);
              pins.appendChild(pin);
            });
          caption.textContent =
            "visitors from " + data.countries + (data.countries === 1 ? " country" : " countries") + " · " + data.cities + (data.cities === 1 ? " city" : " cities");
          caption.hidden = false;
        })
        .catch(function () {});
    })();
  </script>
{% endif %}
