<div class="news">
  {% assign news = site.data.news %}
  {% if news != blank %}
    {% assign news_size = news | size %}
    {% assign news_limit = news_size %}
    {% assign news_visible_count = news_size %}
    {% if include.limit and page.announcements.limit %}
      {% if page.announcements.scrollable %}
        {% assign news_visible_count = page.announcements.limit %}
      {% else %}
        {% assign news_limit = page.announcements.limit %}
      {% endif %}
    {% endif %}
    <div
      class="table-responsive{% if include.limit and page.announcements.scrollable and news_size > news_visible_count %} news-scrollable has-more-news{% endif %}"
      {% if include.limit and page.announcements.scrollable and news_size > news_visible_count %}
        data-visible-items="{{ news_visible_count }}"
        aria-label="News announcements"
        tabindex="0"
        style="--news-visible-items: {{ news_visible_count }}"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {{ item.text | markdownify | remove: '<p>' | remove: '</p>' | emojify }}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
