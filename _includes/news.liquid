<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% assign news_limit = news_size %}
    {% assign news_visible_count = news_size %}
    {% if include.limit and page.announcements.limit %}
      {% if page.announcements.scrollable %}
        {% assign news_visible_count = page.announcements.limit %}
      {% else %}
        {% assign news_limit = page.announcements.limit %}
      {% endif %}
    {% endif %}
    <div
      class="table-responsive{% if include.limit and page.announcements.scrollable and news_size > news_visible_count %} news-scrollable{% endif %}"
      {% if include.limit and page.announcements.scrollable and news_size > news_visible_count %}
        data-visible-items="{{ news_visible_count }}"
        aria-label="News announcements"
        tabindex="0"
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
